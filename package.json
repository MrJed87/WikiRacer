{
  "name": "wikipedia-graph-race",
  "private": true,
  "description": "Race language models through Wikipedia, using only the links on each page.",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
